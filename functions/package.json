{
  "name": "research-reader-functions",
  "version": "1.0.0",
  "description": "Backend functions for Research Reader: Push notifications & Gemini curation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "20"
  }
}
